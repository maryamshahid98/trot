# Copy this file to .env (at the project root) and fill in the blanks. .env is never committed.
# The API reads it once at start-up and refuses to start, naming each problem, if a required value is missing or invalid.
# A blank line means "use the default" shown in brackets.

# Only the database scripts look at this: `db:seed` refuses to run when it is "production".
NODE_ENV=development            # development | test | production   [development]
PORT=3000                       # [3000]

# ---- Database (required, no defaults) ----
# The API connects as the limited trot_app role, so branch isolation (row-level security) applies.
DATABASE_URL=postgres://trot_app:CHANGE_ME@localhost:5432/trot
# Used only by the migration and seed scripts: the database superuser.
ADMIN_DATABASE_URL=postgres://trot:trot@localhost:5432/trot
# `npm run db:migrate` sets the trot_app password to this (at least 8 characters). Use the same one in DATABASE_URL.
# In production leave it blank and set the role's password yourself: ALTER ROLE trot_app PASSWORD '...';
APP_DB_PASSWORD=CHANGE_ME_TOO

# The tests run on their own database, never on the one above. `npm test` drops and rebuilds it every time,
# so its name must end in "_test".
TEST_DATABASE_URL=postgres://trot_app:CHANGE_ME@localhost:5432/trot_test
TEST_ADMIN_DATABASE_URL=postgres://trot:trot@localhost:5432/trot_test

# Optional database tuning
# DB_POOL_MAX=10                # [10]
# DB_IDLE_TIMEOUT_MS=30000      # [30000]
# DB_STATEMENT_TIMEOUT_MS=15000 # a query that runs longer is cancelled   [15000]
# DB_SSL=false                  # true to require a verified TLS connection   [false]

# ---- Sign-in ----
# REQUIRED, no default: at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# JWT_ISSUER=trot               # [trot]
# JWT_AUDIENCE=trot-api         # [trot-api]
# ACCESS_TOKEN_TTL_SECONDS=900  # [900, 15 minutes]
# REFRESH_TOKEN_TTL_DAYS=14     # [14]
# MAX_FAILED_LOGINS=5           # wrong passwords before a temporary lock   [5]
# LOCKOUT_MINUTES=15            # [15]
# AUTH_RATE_LIMIT=20            # sign-in requests per address per window   [20]
# RATE_LIMIT_WINDOW_SECONDS=60  # [60]

# ---- Web ----
# Websites allowed to call the API from a browser, comma separated. Blank = none. The mobile apps do not need this.
CORS_ORIGINS=http://localhost:5173
# The website keeps its sign-in token in a cookie that page scripts cannot read. Set to true wherever the site runs on https
# (always in production), so the cookie never travels over plain http. Leave false for http://localhost. [false]
# COOKIE_SECURE=true
# Number of reverse proxies in front of the API, so the real client address is used for rate limiting. [0]
# TRUST_PROXY=1
# HSTS_MAX_AGE_SECONDS=15552000 # [15552000, 180 days]

# ---- Background job ----
# Seconds between runs of the job that releases unpaid holds, passes on unanswered waitlist offers and expires old packages. 0 = off. [60]
# JOBS_INTERVAL_SECONDS=60

# ---- Rider documents (scans and photos of medical forms, waivers and IDs) ----
# The folder where uploaded files are kept. It must survive restarts and be backed up together with the database.
# UPLOAD_DIR=./data/uploads     # [./data/uploads]; the Docker image uses /data/uploads
# UPLOAD_MAX_BYTES=5242880      # largest file accepted, 1 KB to 25 MB   [5242880, 5 MB]

# ---- Messages (email to riders, guardians and staff) ----
# log  = write a line to the log instead of sending (the default; fine for development, nothing leaves the machine)
# smtp = send real email through your provider (also set SMTP_HOST and EMAIL_FROM)
# off  = send nothing; messages are recorded as skipped
# NOTIFY_EMAIL=log
# NOTIFY_SMS=off                # log | off. No SMS provider is built in yet.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587                 # [587]
# SMTP_SECURE=false             # true when the connection starts encrypted (usually port 465)   [false]
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=Trot Club <no-reply@club.example>
# REMINDER_HOURS=24             # a class reminder goes out this many hours before the class   [24]
# LOW_BALANCE_CLASSES=2         # warn when a package has this many classes or fewer left   [2]
# PACKAGE_EXPIRY_NOTICE_DAYS=7  # [7]
# DOCUMENT_EXPIRY_NOTICE_DAYS=14  # [14]

# ---- Demo data (development only: db:seed refuses to run when NODE_ENV=production) ----
# Password given to the demo accounts (at least 10 characters).
SEED_PASSWORD=
