{
  "name": "@trot/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "tsx --env-file-if-exists=../../.env src/main.ts",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run db:test-setup && tsx --env-file-if-exists=../../.env --test test/*.test.ts",
    "db:migrate": "tsx --env-file-if-exists=../../.env scripts/migrate.ts migrate",
    "db:seed": "tsx --env-file-if-exists=../../.env scripts/migrate.ts seed",
    "storage:check": "tsx --env-file-if-exists=../../.env scripts/storage.ts check",
    "storage:create-bucket": "tsx --env-file-if-exists=../../.env scripts/storage.ts create-bucket",
    "storage:copy-to-s3": "tsx --env-file-if-exists=../../.env scripts/storage.ts copy-to-s3",
    "db:test-setup": "tsx --env-file-if-exists=../../.env scripts/migrate.ts test-setup"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1179.0",
    "@nestjs/common": "^11.2.11",
    "@nestjs/core": "^11.2.11",
    "@nestjs/platform-express": "^11.2.11",
    "@trot/domain": "*",
    "express": "^5.2.1",
    "jose": "^5.9.0",
    "nodemailer": "^10.6.1",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tsx": "^4.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.0",
    "typescript": "^5.6.0"
  }
}
